HOST=localhost
PORT=5000

# MongoDB (local instance). Change the URI if your DB runs elsewhere.
MONGODB_URI=mongodb://127.0.0.1:27017
DATABASE_NAME=jansambandha

# JWT Authentication. Generate a real one locally:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# Comma-separated allowed browser origins (the frontend dev server).
CORS_ORIGINS=http://localhost:3000

# Set true only when behind a trusted reverse proxy.
TRUST_PROXY=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=50
