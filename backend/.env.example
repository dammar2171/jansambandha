PORT=5000
JWT_SECRET=replace-with-a-long-random-secret

# Comma-separated allowed browser origins. Leave empty to allow all.
CORS_ORIGINS=http://localhost:3000
# Set true only when behind a trusted reverse proxy (needed for correct client IPs).
TRUST_PROXY=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
