HOST=localhost
PORT=5000

# MongoDB connection. The database name is kept separate from the URI.
MONGODB_URI=mongodb://127.0.0.1:27017
DATABASE_NAME=jansambandha

# Authentication. Use a long random string in every environment.
JWT_SECRET=replace-with-a-long-random-secret

# Comma-separated allowed browser origins. Leave empty to allow all.
CORS_ORIGINS=http://localhost:3000
# Set true only when behind a trusted reverse proxy (needed for correct client IPs).
TRUST_PROXY=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=50
